{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Launch app.exe",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/app.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "E:/msys2/ucrt64/bin/gdb.exe",
      "setupCommands": [
        { "text": "-gdb-set disassembly-flavor intel" }
      ],
      "preLaunchTask": "Build C++ (g++ UCRT64)"
    }
  ]
}
